# --- App Configuration ---
NODE_ENV=production
PORT=3000

# --- Database (PostgreSQL with pgvector) ---
# When using Docker Compose, these match the 'db' service credentials
PGHOST=wink-db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_password
PGDATABASE=winkwebhook

# --- OpenAI (RAG & AI Chat) ---
OPENAI_API_KEY=sk-proj-...

# --- Facebook Webhook & App ---
# Verify Token must match what you enter in Facebook Dev Portal
VERIFY_TOKEN=mytoken123
FB_APP_ID=your_fb_app_id
FB_APP_SECRET=your_fb_app_secret
# Redirect URI for OAuth (e.g., https://api.yourdomain.com/api/auth/facebook/callback)
FB_REDIRECT_URI=https://your-domain.com/api/auth/facebook/callback
# Instagram Redirect URI (can be the same but mapped differently in FB app)
IG_REDIRECT_URI=https://your-domain.com/api/auth/instagram/callback

# --- Clerk (Authentication) ---
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_... # Must match CLERK_PUBLISHABLE_KEY

# --- Security (JWT) ---
# Generate long, random hex strings for these
JWT_ACCESS_SECRET=your_long_secret_1
JWT_REFRESH_SECRET=your_long_secret_2
