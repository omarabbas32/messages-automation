# --- App Configuration ---
NODE_ENV=production
PORT=3000

# --- Database (PostgreSQL with pgvector) ---
# When using Docker Compose, these match the 'db' service credentials
PGHOST=wink-db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_password
PGDATABASE=winkwebhook

# --- OpenAI (RAG & AI Chat) ---
OPENAI_API_KEY=sk-proj-...

# --- Facebook App (for Facebook Pages messaging) ---
VERIFY_TOKEN=mytoken123
FB_APP_ID=your_fb_app_id
FB_APP_SECRET=your_fb_app_secret
# Callback must be registered in Meta App → Facebook Login → Valid OAuth Redirect URIs
FB_REDIRECT_URI=https://your-domain.com/api/auth/facebook/callback

# --- Instagram App (separate Meta app for Instagram DMs) ---
# App name: WinkWebHook-IG (or similar)
# Needs: instagram_basic, instagram_manage_messages, pages_show_list
IG_APP_ID=your_ig_app_id
IG_APP_SECRET=your_ig_app_secret
# Callback must be registered in the IG Meta App → Facebook Login → Valid OAuth Redirect URIs
IG_REDIRECT_URI=https://your-domain.com/api/auth/instagram/callback

# --- Clerk (Authentication) ---
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_... # Must match CLERK_PUBLISHABLE_KEY

# --- Security (JWT) ---
# Generate long, random hex strings for these
JWT_ACCESS_SECRET=your_long_secret_1
JWT_REFRESH_SECRET=your_long_secret_2
